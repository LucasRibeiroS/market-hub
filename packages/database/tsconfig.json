{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"lib": [
			"dom",
			"es6",
			"es2020",
			"esnext.asynciterable"
		],
		"skipLibCheck": true,
		"sourceMap": true,
		"rootDir": ".",
		"outDir": "./dist",
		"moduleResolution": "node",
		"removeComments": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"@entities": ["src/modules/entities/index.ts"],
			"@entities/*": ["src/modules/entities/*"],
			"@utils/*": ["src/shared/utils/*"],
			"@drizzle": ["src/modules/drizzle/index.ts"],
            "@drizzle/*": ["src/modules/drizzle/*"],
			"@transaction": ["src/modules/transaction/index.ts"],
			"@transaction/*": ["src/modules/transaction/*"],
		},
	},
	"tsc-alias": {
		"resolveFullPaths": true,
		"verbose": false
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"src/**/*.ts",
		"drizzle.config.ts",
	]
}