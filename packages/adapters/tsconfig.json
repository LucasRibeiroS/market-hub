{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"lib": [
			"dom",
			"es6",
			"es2020",
			"esnext.asynciterable"
		],
		"skipLibCheck": true,
		"sourceMap": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"moduleResolution": "node",
		"removeComments": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"@utils/*": ["src/core/utils/*"],
			"@clients/*": ["src/core/clients/*"],
			"@cache/*": ["src/modules/cache/*"],
			"@lock/*": ["src/modules/lock/*"],
			"@logger/*": ["src/modules/logger/*"],
			"@storage/*": ["src/modules/storage/*"],
		}
	},
	"tsc-alias": {
		"resolveFullPaths": true,
		"verbose": false
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"./src/**/*.ts"
	]
}