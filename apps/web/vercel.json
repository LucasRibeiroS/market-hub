{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm build",
	"outputDirectory": "dist/integrator-web/browser",
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://TROQUE-PELO-SEU-SERVICO.onrender.com/:path*"
		},
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	]
}
