# Variables used by `pnpm --filter @integrator/api db:seed` (copy to .env.seed)
# Target database. If omitted, the seed runs against the DATABASE_URL from .env (local database)
DATABASE_URL=

# Public URL of the web app, used to build the providers redirect_uri
SEED_WEB_URL=

# Initial account
SEED_USER_NAME=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Mercado Livre application (DevCenter)
SEED_MELI_CLIENT_ID=
SEED_MELI_CLIENT_SECRET=

# Magalu application
SEED_MAGALU_CLIENT_ID=
SEED_MAGALU_CLIENT_SECRET=
# Defaults to the sandbox API
SEED_MAGALU_BASE_URL=https://api-sandbox.magalu.com
