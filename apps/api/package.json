{
  "name": "@integrator/api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "start:dev": "node --watch dist/servers/index.js",
    "build": "tsc && tsc-alias",
    "start": "node dist/servers/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env.seed dist/scripts/seed.js",
    "lint": "eslint '**/src/**/*.{ts,tsx}' --fix",
    "test": "vitest -c vitest.config.ts",
    "email:dev": "email dev --dir src/views --port 7652",
    "clean": "rm -rf dist node_modules"
  },
  "type": "module",
  "keywords": [],
  "author": "Lucas Ribeiro <lucas.ribeiro@specterlabs.com.br>",
  "license": "ISC",
