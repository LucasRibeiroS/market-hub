    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.4",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.4",
    "fast-jwt": "^6.0.2",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "nodemailer": "^7.0.3",
