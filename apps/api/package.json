    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@integrator-packages/adapters": "workspace:*",
    "@integrator-packages/database": "workspace:*",
    "@integrator-packages/use-case": "workspace:*",
    "@react-email/components": "0.1.0",
    "@scalar/fastify-api-reference": "^1.31.2",
    "@sinclair/typebox": "^0.34.33",
    "@specter-labs/fastify-cache": "^1.0.3",
    "@specter-labs/fastify-logger": "^1.0.3",
