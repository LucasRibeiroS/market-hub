# Environment variables used are declared in this file
# Settings
TZ=
NODE_ENV=
APPLICATION_NAME=
PORT=
QUEUE_MONITORING_PORT=
# Public URL of the API, including the path prefix when served behind a proxy (e.g. https://example.com/api)
APP_URL=
