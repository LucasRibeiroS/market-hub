# CLUSTER_WORKERS=1

# Clients
DATABASE_URL=
REDIS_HOST=
REDIS_PORT=

# Authentication
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES=
PASSWORD_RESET_EXPIRES=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USE_SSL=
SMTP_USER=
SMTP_PASS=
SMTP_SOURCE=

# Encryption
ENCRYPTION_SALT=
ENCRYPTION_KEY=
HASH_KEY=