{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"lib": [
			"dom",
			"es6",
			"es2022",
			"esnext.asynciterable"
		],
		"skipLibCheck": true,
		"sourceMap": true,
		"outDir": "./dist",
		"moduleResolution": "node",
		"removeComments": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"@adapters/*": ["src/application/adapters/*"],
			"@entities": ["src/application/entities/index.ts"],
			"@entities/*": ["src/application/entities/*"],
			"@repositories/*": ["src/application/repositories/*"],
			"@use-cases/*": ["src/application/use-cases/*"],
			"@utils/*": ["src/shared/utils/*"],
			"@clients/*": ["src/shared/clients/*"],
			"@http/*": ["src/servers/http/*"],
			"@views/*": ["src/views/*"],
			"@drizzle": ["database/drizzle/index.ts"],
            "@drizzle/*": ["database/drizzle/*"],
		},
		"jsx": "react-jsx",
	},
	"tsc-alias": {
		"resolveFullPaths": true,
		"verbose": false
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"./src/**/*.ts",
		"./src/views/**/*.tsx",
		"./database/**/*.ts",
		"drizzle.config.ts"
	]
}